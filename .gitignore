# venv and python bits
venv/
__pycache__/
*.py[cod]
*$py.class
.env

# Project specific
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# IDE and System
.vscode/
.idea/
.history/
.DS_Store
*.log
*.tmp
*.zip
*.mkv
*.mp4
*.avi
*.mov
*.webm

# FFmpeg binaries (downloaded on first run)
bin/windows/*
bin/linux/*
bin/darwin/*
!bin/windows/.gitkeep
!bin/linux/.gitkeep
!bin/darwin/.gitkeep
